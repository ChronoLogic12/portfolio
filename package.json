{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "site",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w @portfolio/site",
    "build": "npm run build -w @portfolio/site",
    "preview": "npm run preview -w @portfolio/site",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "synth": "npm run build && npm run synth -w @portfolio/infra",
    "deploy": "npm run build && npm run deploy -w @portfolio/infra"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
