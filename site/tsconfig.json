{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "content-collections": ["./.content-collections/generated"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "content-collections.ts"]
}
